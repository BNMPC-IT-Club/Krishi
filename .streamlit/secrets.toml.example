# ============================================================
# Smart Krishi Buddhimotta — secrets template
# Copy to .streamlit/secrets.toml and fill in YOUR values.
# NEVER commit the real secrets.toml (it is git-ignored).
# On Streamlit Cloud: Settings -> Secrets -> paste this content.
# ============================================================

# --- Groq AI assistant (optional; app runs without it) ---
# Get a FREE key at https://console.groq.com  (no credit card needed)
GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Telegram alerts (optional, 100% free) ---
# 1) Create a bot with @BotFather -> copy the HTTP API token
# 2) Open your bot in Telegram and send /start
# 3) The app can auto-detect your chat id, or put it here manually
[telegram]
bot_token = "123456789:AAExampleExampleExampleExampleExample"
chat_id = "123456789"

# NOTE: Weather uses Open-Meteo and needs NO API key.
# NOTE: Market prices come from DAM (market.dam.gov.bd) or your own CSV upload — no key needed.
